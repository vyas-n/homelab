// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
  "name": "Ubuntu",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/base:noble",

  // Features to add to the dev container. More info: https://containers.dev/features
  "features": {
    "ghcr.io/meaningful-ooo/devcontainer-features/fish:2.0.0": {},
    "ghcr.io/eitsupi/devcontainer-features/nushell:0.1.1": {},
    "ghcr.io/atty303/devcontainer-features/mise:1.3.0": {},
    "ghcr.io/rocker-org/devcontainer-features/apt-packages:1.0.2": {
      "packages": "dnsutils"
    }
  },

  "containerEnv": {
    // Needed for mise create commands to run successfully
    "MISE_TRUSTED_CONFIG_PATHS": "${containerWorkspaceFolder}"
  },

  "remoteUser": "vscode",
  // This is for dns resolution of tailscale endpoints
  "runArgs": ["--dns-search=tail5c72f1.ts.net"],

  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // "forwardPorts": [],

  // Use 'postCreateCommand' to run commands after the container is created.
  "postCreateCommand": {
    "mise-fish-completion": "mise completion fish > ~/.config/fish/completions/mise.fish",
    "uv-fish-completion": "mise exec uv -- uv generate-shell-completion fish > ~/.config/fish/completions/uv.fish",
    "k0sctl-fish-completion": "mise exec go:github.com/k0sproject/k0sctl -- k0sctl completion > ~/.config/fish/completions/k0sctl.fish",
    "mise-and-uv-install": "mise install && mise exec uv -- uv python install && mise exec uv -- uv sync",
    "mise-fish-activate": "mise activate fish > ~/.config/fish/conf.d/mise.fish"
  },

  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "settings": {
        "debug.javascript.defaultRuntimeExecutable": {
          "pwa-node": "/home/vscode/.local/share/mise/shims/node"
        },
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[properties]": {
          "editor.defaultFormatter": "foxundermoon.shell-format"
        },
        "[terraform]": {
          "editor.defaultFormatter": "hashicorp.terraform"
        }
      },
      "extensions": [
        "mkhl.direnv",
        "tamasfe.even-better-toml",
        "esbenp.prettier-vscode",
        "thenuprojectcontributors.vscode-nushell-lang",
        "redhat.vscode-yaml",
        "hashicorp.terraform",
        "foxundermoon.shell-format"
      ]
    }
  }

  // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
}
