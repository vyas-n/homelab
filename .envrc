#!/usr/bin/env bash

ANSIBLE_CONFIG=$(expand_path ./ansible/ansible.cfg)
export ANSIBLE_CONFIG

# Used by ansible to lookup secrets
#
# TODO: refactor terraform to also use this secret
OP_SERVICE_ACCOUNT_TOKEN=$(op read 'op://personal/1Pass-ServiceAccount-HomeLab-Laptop-Deploy/credential')
export OP_SERVICE_ACCOUNT_TOKEN
